# Chỉ đặt khóa này trên backend. Không đưa khóa vào Flutter hoặc Git.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6.1-sol
LLM_PROVIDER=openai

# PostgreSQL + pgvector cho bộ nhớ phiên và tìm kiếm kiến thức theo ngữ nghĩa.
POSTGRES_DB=smart_agri
POSTGRES_USER=smart_agri
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://smart_agri:change-this-password@127.0.0.1:5432/smart_agri
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Chế độ local dự phòng:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b
